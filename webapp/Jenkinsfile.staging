pipeline {
  agent any
  tools {
    nodejs '26.12.0'
  }

  parameters {
    string(name: 'ARTIFACT_ID', defaultValue: 'staging', description: '')
  }

  environment {
    VERCEL_TOKEN = credentials('VERCEL_TOKEN')
  }

  options {
    timeout(time: 2, unit: 'MINUTES')
  }

  stages {
    stage('Deploy') {
      steps {
        script {
            sh '''ECHO "FROM $ARTIFACT_ID >> Dockerfile && vercel deploy --yes'''
        }
      }
    }
  }
  
  post {
    always {
        cleanWs()
    }
  }
}
